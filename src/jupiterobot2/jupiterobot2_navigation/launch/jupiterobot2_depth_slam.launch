<launch>
  <arg name="sim" default="false"/>
  <!-- Multi camera -->
  <group unless="$(arg sim)">
    <include file="$(find jupiterobot2_bringup)/launch/multi_camera.launch"/>
  </group>

  <!-- Arguments -->
  <arg name="slam_methods" default="depth_gmapping"/>
  <arg name="open_rviz" default="true"/>

  <!-- SLAM: Gmapping -->
  <include file="$(find jupiterobot2_navigation)/launch/includes/$(arg slam_methods).launch"/>

  <!-- rviz -->
  <group if="$(arg open_rviz)"> 
    <node pkg="rviz" type="rviz" name="rviz" required="true"
          args="-d $(find jupiterobot2_navigation)/rviz/$(arg slam_methods).rviz"/>
  </group>
</launch>
