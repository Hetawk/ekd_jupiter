<launch>
    <!-- unique camera name-->
    <arg name="camera_name" default="camera"/>
    <!-- Hardware depth registration -->
    <arg name="3d_sensor" default="astra"/>
    <!-- stereo_s_u3, astrapro, astra -->
    <arg name="camera1_prefix" default=""/>
    <arg name="camera2_prefix" default="bot"/>
    <arg name="camera1_serila_number" default="AD7M83300MR"/>
    <arg name="camera2_serila_number" default="AD74B3300Y1"/>
    <arg name="device_num" default="2"/>

    <node name="camera" pkg="astra_camera" type="cleanup_shm_node" output="screen"/>

    <include file="$(find astra_camera)/launch/$(arg 3d_sensor).launch">
        <arg name="camera_name" value="$(arg camera_name)"/>
        <arg name="serial_number" value="$(arg camera1_serila_number)"/>
        <arg name="device_num" value="$(arg device_num)"/>
    </include>

    <include file="$(find astra_camera)/launch/$(arg 3d_sensor).launch">
        <arg name="camera_name" value="$(arg camera_name)_$(arg camera2_prefix)"/>
        <arg name="serial_number" value="$(arg camera2_serila_number)"/>
        <arg name="device_num" value="$(arg device_num)"/>
    </include>

    <!-- <node pkg="tf2_ros" type="static_transform_publisher" name="camera_tf"
          args="0 0 0 0 0 0 camera_link camera_bot_link"/> -->

    <!--                            Laserscan 
        This uses lazy subscribing, so will not activate until scan is requested.
    -->
    <arg name="scan_processing" default="true"/>
    <arg name="scan_topic" default="depth_scan"/>
    <group if="$(arg scan_processing)">
        <node pkg="depthimage_to_laserscan" type="depthimage_to_laserscan" name="depthimage_to_laserscan">
            <param name="scan_height" value="10"/>
            <param name="output_frame_id" value="$(arg camera_name)_$(arg camera2_prefix)_depth_frame"/>
            <param name="range_min" value="0.45"/>
            <remap from="image" to="$(arg camera_name)_$(arg camera2_prefix)/depth/image_raw"/>
            <remap from="scan" to="$(arg scan_topic)"/>
            <remap from="$(arg camera_name)_$(arg camera2_prefix)/image" to="$(arg camera_name)_$(arg camera2_prefix)/depth/image_raw"/>
            <remap from="$(arg camera_name)_$(arg camera2_prefix)/scan" to="$(arg scan_topic)"/>
        </node>
    </group>
</launch>
